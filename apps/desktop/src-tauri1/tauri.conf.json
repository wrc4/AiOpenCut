{
  "package": {
    "productName": "OpenCut Desktop",
    "version": "0.1.0"
  },
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "devPath": "http://localhost:3000",
    "distDir": "../web/.next"
  },
  "tauri": {
    "bundle": {
      "identifier": "com.wrc4.opencut",
      "icon": []
    },
    "security": {
      "csp": "default-src 'self' http://localhost:3000; script-src 'self' 'unsafe-eval' 'unsafe-inline';"
    },
    "allowlist": {
      "all": false,
      "fs": { "all": true },
      "dialog": { "all": true },
      "process": { "all": true },
      "shell": { "all": false, "open": true }
    },
    "windows": [
      {
        "title": "OpenCut",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ]
  }
}
